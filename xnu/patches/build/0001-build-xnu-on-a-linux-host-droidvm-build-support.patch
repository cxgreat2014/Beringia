+++ b/SETUP/config/Makefile
@@ -18,9 +18,11 @@ LDFLAGS = -isysroot $(HOST_SDKROOT) -mmacosx-version-min=$(HOST_OS_VERSION)
 
 config: $(OBJS)
 	@$(LOG_HOST_LD) "$@"
-	$(_v)$(HOST_CC) $(LDFLAGS) -o $@ $^
+	$(_v)$(HOST_CC) $(LDFLAGS) -o $@ $^ $(LINUX_HOST_LIBS)
+ifneq ($(HOST_PLATFORM),Linux)
 	@$(LOG_HOST_CODESIGN) "$@"
 	$(_v)env CODESIGN_ALLOCATE=$(HOST_CODESIGN_ALLOCATE) $(HOST_CODESIGN) -s - $@
+endif
 
