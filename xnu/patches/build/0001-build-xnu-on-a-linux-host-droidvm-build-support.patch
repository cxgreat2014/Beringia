-INCFLAGS_PLATFORM = -I$(SDKROOT)/$(KPINCDIR)/platform
+INCFLAGS_KERNEL = -I$(KERNEL_SDKROOT)/usr/local/include/kernel
+INCFLAGS_SDK	= -I$(KERNEL_SDKROOT)/usr/local/include/kernel -I$(KERNEL_SDKROOT)/usr/local/include -I$(KERNEL_SDKROOT)/usr/local/include/iBoot -I$(KERNEL_SDKROOT)/$(KPINCDIR)/AppleFeatures
+INCFLAGS_PLATFORM = -I$(KERNEL_SDKROOT)/$(KPINCDIR)/platform
 ifneq ($(KDKROOT),)
