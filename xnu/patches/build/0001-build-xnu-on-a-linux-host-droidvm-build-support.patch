 	@$(LOG_HOST_CC) "$@"
@@ -40,3 +42,8 @@ do_build_setup:: config
 
 include $(MakeInc_rule)
 include $(MakeInc_dir)
+
+ifeq ($(HOST_PLATFORM),Linux)
+CFLAGS := $(filter-out -isysroot $(HOST_SDKROOT) -mmacosx-version-min=$(HOST_OS_VERSION),$(CFLAGS)) $(LINUX_HOST_CFLAGS)
+LDFLAGS := $(filter-out -isysroot $(HOST_SDKROOT) -mmacosx-version-min=$(HOST_OS_VERSION),$(LDFLAGS))
+endif
