From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Weiyi Feng <fwy1998@gmail.com>
Date: Sat, 28 Nov 2026 12:31:19 +0800
Subject: [PATCH] hosted: ABI 4 for the shutdown bits

Patch 0048 added BERINGIA_PENDING_STOP/_ESTOP handling; a kernel built before it
must not be sent them, so the shared header version says 4.
---
 EXTERNAL_HEADERS/beringia/abi.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/EXTERNAL_HEADERS/beringia/abi.h b/EXTERNAL_HEADERS/beringia/abi.h
index 2f2da88..f036fbe 100644
--- a/EXTERNAL_HEADERS/beringia/abi.h
+++ b/EXTERNAL_HEADERS/beringia/abi.h
@@ -20,7 +20,7 @@
 #ifndef BERINGIA_ABI_H
 #define BERINGIA_ABI_H
 
-#define BERINGIA_ABI_VERSION    3       /* 1: block calls 34/35; 2: beringia_shared.dump_filter; 3: kernel_abi */
+#define BERINGIA_ABI_VERSION    4       /* 1: block calls 34/35; 2: dump_filter; 3: kernel_abi; 4: STOP/ESTOP */
 #define BERINGIA_KERNEL_BASE    0xffffff8000000000ULL   /* x86_64 XNU KERNEL_BASE: image PA = VA - this */
 #define BERINGIA_MAX_CPUS       64
 
