From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Weiyi Feng <fwy1998@gmail.com>
Date: Thu, 26 Nov 2026 05:04:02 +0800
Subject: [PATCH 14/17] hosted: route the TSC-deadline timer and idle to the
 host

---
 osfmk/i386/lapic_native.c |  8 ++++++++
 osfmk/i386/pmCPU.c        | 14 +++++++++++---
 2 files changed, 19 insertions(+), 3 deletions(-)

diff --git a/osfmk/i386/lapic_native.c b/osfmk/i386/lapic_native.c
index e98b0bd..0e9b297 100644
--- a/osfmk/i386/lapic_native.c
+++ b/osfmk/i386/lapic_native.c
@@ -824,6 +824,11 @@ lapic_set_timer_fast(
 void
 lapic_set_tsc_deadline_timer(uint64_t deadline)
 {
+	/* BERINGIA: the host owns the real TSC-deadline MSR; arm its timer, which marks this CPU pending and kicks it. */
+	if (beringia_hosted()) {
+		beringia_call(BERINGIA_CALL_SET_TIMER, deadline, 0);
+		return;
+	}
 	/* Don't bother disarming: wrmsr64(MSR_IA32_TSC_DEADLINE, 0); */
 	wrmsr64(MSR_IA32_TSC_DEADLINE, deadline);
 }
@@ -831,6 +836,9 @@ lapic_set_tsc_deadline_timer(uint64_t deadline)
 uint64_t
 lapic_get_tsc_deadline_timer(void)
 {
+	if (beringia_hosted()) {
+		return beringia_shared.cpu[beringia_cpu()].timer_deadline;
+	}
 	return rdmsr64(MSR_IA32_TSC_DEADLINE);
 }
 
diff --git a/osfmk/i386/pmCPU.c b/osfmk/i386/pmCPU.c
index 34a01c0..22ca977 100644
--- a/osfmk/i386/pmCPU.c
+++ b/osfmk/i386/pmCPU.c
@@ -31,6 +31,7 @@
  *
  * Implements the "wrappers" to the KEXT.
  */
+#include <beringia_hosted.h>
 #include <i386/asm.h>
 #include <i386/machine_cpu.h>
 #include <i386/mp.h>
@@ -171,9 +172,16 @@ machine_idle(void)
 		 * cause problems in some MP configurations w.r.t. the APIC
 		 * stopping during a GV3 transition).
 		 */
-		pal_hlt();
-		/* Once woken, re-disable interrupts. */
-		pal_cli();
+		if (beringia_hosted()) {
+			/* BERINGIA: idle on the host (Linux runs other work on this CPU). The host wakes us when the XNU timer
+			 * it armed for us fires or another CPU kicks us; the pending timer/IPI is delivered by the forwarded
+			 * interrupt path. hlt would park this CPU with nothing to wake it (the LAPIC is the host one). */
+			beringia_call(BERINGIA_CALL_IDLE, 0, (unsigned long)&beringia_shared.cpu[beringia_cpu()].pending);
+		} else {
+			pal_hlt();
+			/* Once woken, re-disable interrupts. */
+			pal_cli();
+		}
 	}
 
