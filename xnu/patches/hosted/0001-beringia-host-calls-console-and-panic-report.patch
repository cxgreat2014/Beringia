diff --git a/osfmk/kern/debug.c b/osfmk/kern/debug.c
index dfe70a7..7e96529 100644
--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -55,6 +55,9 @@
  */
 
 #include <mach_assert.h>
+#if defined(__x86_64__)
+#include <beringia_hosted.h>
+#endif
 #include <mach_kdp.h>
 #include <kdp/kdp.h>
 #include <kdp/kdp_core.h>
@@ -1217,6 +1220,24 @@ panic_trap_to_debugger(const char *panic_format_str, va_list *panic_args, unsign
 {
 #pragma clang diagnostic pop
 
+#if defined(__x86_64__)
+	if (beringia_hosted()) {
+		/* BERINGIA: the formatted panic message to the host, which ends the run. */
+		static char beringia_panic_buf[1024];
+		const char *msg = panic_format_str ? panic_format_str : "panic";
+
+		if (panic_args != NULL && panic_format_str != NULL) {
+			va_list ap;
+
+			va_copy(ap, *panic_args);
+			vsnprintf(beringia_panic_buf, sizeof(beringia_panic_buf), panic_format_str, ap);
+			va_end(ap);
+			msg = beringia_panic_buf;
+		}
+		beringia_panic(msg);
+	}
+#endif
+
 #if defined(__x86_64__) && (DEVELOPMENT || DEBUG)
 	read_lbr();
 #endif
