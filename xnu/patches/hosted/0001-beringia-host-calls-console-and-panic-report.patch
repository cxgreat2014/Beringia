+/*
+ * BERINGIA: XNU hosted inside Linux (https://github.com/cxgreat2014/Beringia).
+ *
+ * When the loader sets beringia_hook before entering vstart, this kernel runs as a guest of the Linux host in the
+ * same CPU privilege level: it owns its page tables, descriptor tables and MSRs while it runs (the host switches them),
+ * but hardware it would normally program (LAPIC, IOAPIC, serial ports, MTRRs, ACPI) belongs to Linux. The hosted paths
+ * are all guarded by beringia_hosted(); with beringia_hook == 0 the kernel behaves as stock XNU.
+ */
+#ifndef _BERINGIA_HOSTED_H_
+#define _BERINGIA_HOSTED_H_
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <beringia/abi.h>
+
+extern uint64_t beringia_hook;
+extern struct beringia_shared beringia_shared;
+
+static inline bool
+beringia_hosted(void)
+{
+	return beringia_hook != 0;
+}
+
+/* This CPU's host index: the host keeps it in IA32_TSC_AUX while XNU runs (valid before %gs is set up). */
+static inline unsigned int
+beringia_cpu(void)
+{
+	uint64_t aux;
+
+	__asm__ volatile (".byte 0xf3, 0x0f, 0xc7, 0xf8" : "=a"(aux));     /* rdpid %rax */
+	return (unsigned int)(aux & 0xffff);
+}
+
+long beringia_call(unsigned long nr, unsigned long a1, unsigned long a2);
+void beringia_console_putc(char c);
+void beringia_console_write(const char *s, unsigned long len);
+void beringia_panic(const char *msg) __attribute__((noreturn));
+
+#endif /* _BERINGIA_HOSTED_H_ */
