+ * distributed on an 'AS IS' basis, WITHOUT WARRANTY OF ANY KIND, EITHER
+ * EXPRESS OR IMPLIED, AND APPLE HEREBY DISCLAIMS ALL SUCH WARRANTIES,
+ * INCLUDING WITHOUT LIMITATION, ANY WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE, QUIET ENJOYMENT OR NON-INFRINGEMENT.
+ * Please see the License for the specific language governing rights and
+ * limitations under the License.
+ *
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_END@
+ */
+/*
+ * BERINGIA: host calls and the hosted console (see beringia_hosted.h and the Beringia ABI, beringia/abi.h).
+ */
+#include <beringia_hosted.h>
+
+/* Set by the loader before vstart runs; 0 means not hosted. */
+uint64_t beringia_hook = 0;
+/* Filled by the loader (boot facts) and the host (per-CPU pending words). */
+struct beringia_shared beringia_shared __attribute__((aligned(4096)));
+
+static unsigned int beringia_console_pos[BERINGIA_MAX_CPUS];
+
+long
+beringia_call(unsigned long nr, unsigned long a1, unsigned long a2)
+{
+	long r;
+
+	/* SysV call: the host preserves rbx, rbp, r12-r15, the FPU state and the interrupt flag */
+	__asm__ volatile ("call *%[hook]"
+            : "=a"(r), "+D"(nr), "+S"(a1), "+d"(a2)
+            : [hook] "r"(beringia_hook)
+            : "rcx", "r8", "r9", "r10", "r11", "memory", "cc");
+	return r;
+}
+
+static void
+beringia_console_flush(unsigned int cpu)
+{
+	if (beringia_console_pos[cpu]) {
+		beringia_call(BERINGIA_CALL_CONSOLE, cpu, beringia_console_pos[cpu]);
+		beringia_console_pos[cpu] = 0;
+	}
+}
+
+/* One character of console output; a line goes to the host when it ends (or fills the buffer). */
+void
+beringia_console_putc(char c)
+{
+	unsigned int cpu = beringia_cpu() % BERINGIA_MAX_CPUS;
+	struct beringia_cpu_shared *s = &beringia_shared.cpu[cpu];
+
+	if (c == '\r') {
+		return;
+	}
+	if (c == '\n') {
+		beringia_console_flush(cpu);
+		return;
+	}
+	s->console[beringia_console_pos[cpu]++] = c;
+	if (beringia_console_pos[cpu] >= sizeof(s->console) - 1) {
+		beringia_console_flush(cpu);
+	}
+}
+
+void
+beringia_console_write(const char *str, unsigned long len)
+{
+	while (len--) {
+		beringia_console_putc(*str++);
+	}
+}
+
+/* A panic: its message to the host, which ends the run. */
+void
+beringia_panic(const char *msg)
+{
+	unsigned int cpu = beringia_cpu() % BERINGIA_MAX_CPUS;
+	struct beringia_cpu_shared *s = &beringia_shared.cpu[cpu];
+	unsigned long n = 0;
+
+	beringia_console_flush(cpu);
+	while (msg && msg[n] && n < sizeof(s->console) - 1) {
+		s->console[n] = msg[n];
+		n++;
+	}
+	beringia_call(BERINGIA_CALL_PANIC, cpu, n);
+	for (;;) {
+		__asm__ volatile ("cli; hlt");
+	}
+}
diff --git a/pexpert/i386/pe_serial.c b/pexpert/i386/pe_serial.c
index 5e62f29..6f01170 100644
--- a/pexpert/i386/pe_serial.c
+++ b/pexpert/i386/pe_serial.c
@@ -34,6 +34,7 @@
 #include <machine/machine_routines.h>
 #include <pexpert/protos.h>
 #include <pexpert/pexpert.h>
+#include <beringia_hosted.h>
 
 struct pe_serial_functions {
 	void            (*uart_init) (void);
@@ -589,11 +590,39 @@ static struct pe_serial_functions pcie_mmio_uart_serial_functions = {
 // Generic serial support below
 // =============================================================================
 
+#if defined(__x86_64__)
+/* BERINGIA: hosted, the console is the host's (no UART of ours; Linux owns the machine's). */
+static void beringia_uart_init(void) { }
+static void beringia_uart_set_baud_rate(__unused int unit, __unused uint32_t baud_rate) { }
+static int beringia_uart_tr0(void) { return 1; }
+static void beringia_uart_td0(int c) { beringia_console_putc((char)c); }
+static int beringia_uart_rr0(void) { return 0; }
+static int beringia_uart_rd0(void) { return 0; }
+
+static struct pe_serial_functions beringia_serial_functions = {
+	.uart_init = beringia_uart_init,
+	.uart_set_baud_rate = beringia_uart_set_baud_rate,
+	.tr0 = beringia_uart_tr0,
+	.td0 = beringia_uart_td0,
+	.rr0 = beringia_uart_rr0,
+	.rd0 = beringia_uart_rd0
+};
+#endif
+
 int
 serial_init( void )
 {
 	unsigned new_uart_baud_rate = 0;
 
+#if defined(__x86_64__)
+	if (beringia_hosted()) {
+		gPESF = &beringia_serial_functions;
+		uart_initted = 1;
+		legacy_uart_enabled = 1;
+		return 1;
+	}
+#endif
+
 	if (PE_parse_boot_argn("serialbaud", &new_uart_baud_rate, sizeof(new_uart_baud_rate))) {
 		/* Valid divisor? */
 		if (!((LEGACY_UART_CLOCK / 16) % new_uart_baud_rate)) {
