+/*
+ * BERINGIA: the platform expert for a hosted x86_64 XNU.
+ *
+ * The hosted machine has no ACPI, PCI, HPET, IOAPIC or SMC (those belong to the Linux host), so AppleACPIPlatform and
+ * friends cannot drive it. BeringiaPlatform is the minimal IODTPlatformExpert that matches the boot device tree the
+ * loader provides (see loader/boot.c) and lets IOKit proceed: the base class sets gIOPlatform, processes the DT and
+ * creates its nubs. Device support (CPUs, disk, console, ...) is added by the paravirtual kexts, not here.
+ *
+ * Matched through the built-in personality in iokit/KernelConfigTables.cpp with a higher probe score than
+ * IOPanicPlatform, so IOKit picks it instead of panicking with "Unable to find driver for this platform".
+ */
+#include <IOKit/IOPlatformExpert.h>
+
+class BeringiaPlatform : public IODTPlatformExpert
+{
+	OSDeclareDefaultStructors(BeringiaPlatform);
+
+public:
+	/*
+	 * IODTPlatformExpert is abstract only through these two. They are name lists, not optional pointers: returning
+	 * NULL would make IODTFindMatchingEntries match every entry (and deleteList would delete the whole DT,
+	 * /options included, which processTopLevel then needs). An empty string matches nothing: keep the whole DT.
+	 */
+	virtual const char * deleteList( void ) APPLE_KEXT_OVERRIDE { return ""; }
+	virtual const char * excludeList( void ) APPLE_KEXT_OVERRIDE { return ""; }
+
+	/* There is no NVRAM on the hosted platform, and saving the panic log to it would wedge the machine; the host
+	 * already captures the whole console (including the backtrace) synchronously to a file on the Windows side. */
+	virtual IOByteCount savePanicInfo(UInt8 *buffer, IOByteCount length) APPLE_KEXT_OVERRIDE
+	{
+		(void)buffer;
+		return length;
+	}
+};
+
+OSDefineMetaClassAndStructors(BeringiaPlatform, IODTPlatformExpert);
diff --git a/iokit/KernelConfigTables.cpp b/iokit/KernelConfigTables.cpp
index 559a9db..aef04cc 100644
--- a/iokit/KernelConfigTables.cpp
+++ b/iokit/KernelConfigTables.cpp
@@ -34,6 +34,13 @@
 
 const char * gIOKernelConfigTables =
     "("
+    /* BERINGIA: the hosted platform expert matches the boot DT ahead of IOPanicPlatform */
+    "   {"
+    "     'IOClass'         = BeringiaPlatform;"
+    "     'IOProviderClass' = IOPlatformExpertDevice;"
+    "     'IONameMatch'     = 'Beringia1,1';"
+    "     'IOProbeScore'    = 1000:32;"
+    "   },"
     "   {"
     "     'IOClass'         = IOPanicPlatform;"
     "     'IOProviderClass' = IOPlatformExpertDevice;"
