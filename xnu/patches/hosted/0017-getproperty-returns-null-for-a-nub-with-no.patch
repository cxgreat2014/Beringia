From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Weiyi Feng <fwy1998@gmail.com>
Date: Thu, 26 Nov 2026 12:01:33 +0800
Subject: [PATCH 20/22] hosted: getProperty returns NULL for a nub with no
 property table

---
 iokit/Kernel/IORegistryEntry.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/iokit/Kernel/IORegistryEntry.cpp b/iokit/Kernel/IORegistryEntry.cpp
index 1d6b3aa..9a6a6bb 100644
--- a/iokit/Kernel/IORegistryEntry.cpp
+++ b/iokit/Kernel/IORegistryEntry.cpp
@@ -26,6 +26,7 @@
  * @APPLE_OSREFERENCE_LICENSE_HEADER_END@
  */
 
+#include <beringia_hosted.h>
 #include <IOKit/IORegistryEntry.h>
 #include <libkern/c++/OSContainers.h>
 #include <IOKit/IOService.h>
@@ -733,6 +734,10 @@ IORegistryEntry::getProperty( const OSSymbol * aKey) const
 {
 	OSObject * obj;
 
+	/* BERINGIA: a nub with no property table has no properties; return NULL instead of calling getObject on NULL. */
+	if (!getPropertyTable()) {
+		return NULL;
+	}
 	PLOCK;
 	obj = getPropertyTable()->getObject( aKey );
 	PUNLOCK;
