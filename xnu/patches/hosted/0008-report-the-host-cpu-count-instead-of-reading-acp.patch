From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Weiyi Feng <fwy1998@gmail.com>
Date: Thu, 26 Nov 2026 04:17:44 +0800
Subject: [PATCH] hosted: report the host CPU count instead of reading ACPI
 MADT

---
 osfmk/i386/acpi.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/osfmk/i386/acpi.c b/osfmk/i386/acpi.c
index 22c4ff1..9559ee1 100644
--- a/osfmk/i386/acpi.c
+++ b/osfmk/i386/acpi.c
@@ -26,6 +26,7 @@
  * @APPLE_OSREFERENCE_LICENSE_HEADER_END@
  */
 
+#include <beringia_hosted.h>
 #include <i386/pmap.h>
 #include <i386/proc_reg.h>
 #include <i386/mp_desc.h>
@@ -716,6 +717,11 @@ acpi_count_enabled_logical_processors(void)
 	uint32_t enabled_cpu_count = 0;
 	uint64_t rsdp_physaddr;
 
+	/* BERINGIA: there is no ACPI on the hosted platform; the host states how many CPUs XNU has. */
+	if (beringia_hosted()) {
+		return beringia_shared.ncpus ? beringia_shared.ncpus : 1;
+	}
+
 	rsdp_physaddr = efi_get_rsdp_physaddr();
 	if (__improbable(rsdp_physaddr == 0)) {
 		DBG("acpi_count_enabled_logical_processors: Could not get RSDP physaddr from EFI.\n");
