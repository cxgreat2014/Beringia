From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Weiyi Feng <fwy1998@gmail.com>
Date: Fri, 27 Nov 2026 00:25:19 +0800
Subject: [PATCH] hosted: log fatal userspace exception details (bring-up aid)

Print the exception type and the two Mach code words on EXC_BAD_ACCESS /
EXC_BAD_INSTRUCTION / EXC_ARITHMETIC. This is what made the recovery
launchd's crash legible: EXC_BAD_ACCESS with fault address 0 (a NULL
pointer passed to a string/memory routine), rather than a bare
"initproc failed to start".
---
 osfmk/kern/exception.c | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index 49c0c53..d2aacbd 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -100,6 +100,28 @@
 #include <libkern/coreanalytics/coreanalytics.h>
 
 #include <sys/code_signing.h> /* for developer mode state */
+#include <beringia_hosted.h>
+
+/*
+ * BERINGIA: userspace bring-up aid. Hosted only, one console line per exception as it enters triage (not one per
+ * thread/task/host delivery attempt): the exception type, the two Mach code words and who took it. Not every one is
+ * fatal; a handler may still recover from it.
+ */
+static void
+beringia_log_user_exception(thread_t thread, exception_type_t exception, mach_exception_data_t code,
+    mach_msg_type_number_t codeCnt)
+{
+	task_t task;
+
+	if (!beringia_hosted() || codeCnt < 2 ||
+	    (exception != EXC_BAD_ACCESS && exception != EXC_BAD_INSTRUCTION && exception != EXC_ARITHMETIC)) {
+		return;
+	}
+	task = get_threadtask(thread);
+	printf("BERINGIA: user exception %d code %#llx %#llx (pid %d %s, tid %llu)\n", exception,
+	    (unsigned long long)code[0], (unsigned long long)code[1], task_pid(task), task_best_name(task),
+	    thread_tid(thread));
+}
 
 bool panic_on_exception_triage = false;
 
@@ -744,6 +766,8 @@ exception_triage_thread(
 		panic("called exception_triage when it was forbidden by the boot environment");
 	}
 
+	beringia_log_user_exception(thread, exception, code, codeCnt);
+
 	/*
 	 * Try to raise the exception at the activation level.
 	 */
@@ -981,6 +1005,8 @@ bsd_exception(
 	task = current_task();
 	mutex = &task->itk_lock_data;
 
+	beringia_log_user_exception(self, exception, code, codeCnt);
+
 	kr = exception_deliver(self, exception, code, codeCnt, task->exc_actions, mutex);
 
 	if (kr == KERN_SUCCESS || kr == MACH_RCV_PORT_DIED) {
